{
  "name": "broken-robots",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "build:mfe": "node scripts/build.mjs --mfe",
    "preview": "vite preview --config apps/shell/vite.config.ts --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "bff": "node services/bff/server.mjs",
    "test": "node --test services/bff/server.test.mjs scripts/cache-assets.test.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
